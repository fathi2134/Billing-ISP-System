# Server
PORT=3000

# MySQL (XAMPP default: host 127.0.0.1, user root, no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billing_isp

# MikroTik API (winbox: IP -> Services -> API enable)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=api
MIKROTIK_PASSWORD=secret
MIKROTIK_PORT=8728
# Profile yang dipakai saat isolir (harus sudah ada di MikroTik)
MIKROTIK_PROFILE_ISOLIR=isolir

# JWT Secret — WAJIB diganti di production dengan string random yang panjang
JWT_SECRET=ganti_dengan_string_random_minimal_32_karakter

# Midtrans Payment Gateway
# Dapatkan key di https://dashboard.midtrans.com → Settings → Access Keys
# Sandbox: SB-Mid-server-... / SB-Mid-client-... | Production: Mid-server-... / Mid-client-...
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false
# URL frontend (redirect setelah bayar di Snap — harus sama host yang dibuka pelanggan)
# Development: http://localhost:5173 | Production: https://panel.domain-anda.com
CLIENT_URL=http://localhost:5173
#
# Di Midtrans Dashboard → Settings → Configuration → Payment Notification URL (Webhook):
#   https://API-ANDA.com/api/payment/notification
# (bukan localhost — pakai tunnel ngrok/cloudflare saat uji, atau domain production)

# Frontend Vite — SAMA dengan MIDTRANS_CLIENT_KEY (agar Snap.js cocok dengan server key)
# File: client/.env
# VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx

# WhatsApp (scan QR di terminal saat pertama kali jalan)
# Tidak perlu API key; session disimpan di folder .wwebjs_auth
